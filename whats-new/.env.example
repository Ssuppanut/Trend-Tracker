# =============================================================================
# whats-new — environment variables
# Copy to `.env.local` and fill in. NEXT_PUBLIC_* is exposed to the browser.
# =============================================================================

# --- Supabase (Postgres + pgvector + Auth) -----------------------------------
# Project settings → API. https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service-role key — bypasses RLS. SERVER-ONLY, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Reddit ------------------------------------------------------------------
# OAuth2 "script" app: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# --- YouTube -----------------------------------------------------------------
# Data API v3 — simple API key (public read).
# https://console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_API_KEY=""
