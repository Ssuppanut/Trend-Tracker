# =============================================================================
# Trend Tracker — environment variables
# Copy this file to `.env.local` and fill in the values.
# Never commit `.env.local`. NEXT_PUBLIC_* vars are exposed to the browser.
# =============================================================================

# --- App ---------------------------------------------------------------------
# Public base URL of the app (used for absolute links, OAuth redirects).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# User-Agent sent by every ingestion adapter (required by Reddit/Pantip/etc).
INGEST_USER_AGENT="TrendTracker/0.1 (personal project)"

# Random string for protecting /api/cron/* endpoints.
# Generate one, e.g.: openssl rand -hex 32
# On Vercel, set this equal to the Cron secret so scheduled runs authorize too.
CRON_SECRET=""

# =============================================================================
# Supabase (Postgres + pgvector + Auth)
# Project settings → API. https://supabase.com/dashboard
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service-role key — bypasses Row Level Security. SERVER-ONLY, never expose
# to the browser. Used by cron jobs and the ingestion pipeline.
SUPABASE_SERVICE_ROLE_KEY=""

# =============================================================================
# AI — enrichment (LLM summary / classification) + embeddings
# =============================================================================
# Claude API — Haiku for batch classification & trend summaries.
# (LLM insight is deferred in Phase 1; key not required yet.)
ANTHROPIC_API_KEY=""

# --- Embeddings (swappable provider) -----------------------------------------
# Default provider for NEW embeddings: "jina" | "deepinfra". The dashboard's
# selector can override this per fetch; this is just the initial default.
# Providers live behind one interface (lib/embeddings/) — add another by
# implementing it and registering it, with no changes to the trend engine.
EMBEDDINGS_PROVIDER="deepinfra"

# Jina — jina-embeddings-v3, multilingual text, 1024 dims (matches the schema).
# Key from https://jina.ai. Requires `api.jina.ai` on the egress allowlist.
JINA_API_KEY=""
# Optional overrides (defaults shown):
# JINA_EMBEDDINGS_MODEL="jina-embeddings-v3"   # v4 is 2048-dim multimodal
# JINA_EMBEDDINGS_TASK="text-matching"
# JINA_API_URL="https://api.jina.ai/v1/embeddings"

# DeepInfra — bge-m3, 1024 dims. Key from https://deepinfra.com.
# Requires `api.deepinfra.com` on the egress allowlist. ~$0.01 / 1M tokens.
DEEPINFRA_API_KEY=""
# Optional overrides:
# DEEPINFRA_EMBEDDINGS_MODEL="BAAI/bge-m3"
# EMBEDDINGS_API_URL=""      # override the DeepInfra endpoint (OpenAI-compatible)
# EMBEDDINGS_API_KEY=""      # generic key fallback for DeepInfra
# EMBEDDINGS_MODEL="BAAI/bge-m3"   # legacy shared model var (DeepInfra only)

# NOTE: two embedding providers produce DIFFERENT vector spaces even at equal
# dimensions. Each stored embedding is tagged with provider+model; the engine
# never clusters/searches across spaces. Switching the provider only affects
# NEW embeddings — it does not re-embed existing rows.

# =============================================================================
# Sources — Community
# =============================================================================
# Reddit — OAuth2 "script" app: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# Hacker News — no auth required (Firebase / Algolia public API).

# =============================================================================
# Sources — Video / Social
# =============================================================================
# YouTube Data API v3 — simple API key (public read).
# https://console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_API_KEY=""

# TikTok Creative Center — no official API key; scraped. No secret required,
# but keep the region list in the adapter config.

# =============================================================================
# Sources — Search Trends
# =============================================================================
# Google Trends official API (alpha) — once access is granted.
GOOGLE_TRENDS_API_KEY=""
# Apify Google Trends scraper (Plan B while waiting for alpha access).
# https://console.apify.com/account/integrations
APIFY_TOKEN=""

# =============================================================================
# Sources — News (RSS) & Pantip
# =============================================================================
# RSS and Pantip require no credentials. Feed URLs / trending endpoints are
# configured inside their adapters.
